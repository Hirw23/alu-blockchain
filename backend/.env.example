# ============================================================
# SupplyChain+ Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env to git.
#
# Values marked [RENDER DASHBOARD] must be set manually
# in the Render Web Service → Environment tab.
# Render automatically injects DATABASE_URL when you link
# a Render PostgreSQL service to the web service.
# ============================================================

# ─── Application ────────────────────────────────────────────
NODE_ENV=production                        # [RENDER DASHBOARD] set to: production
PORT=3000                                  # Render sets this automatically via $PORT
APP_NAME=SupplyChain+
APP_VERSION=1.0.0
API_VERSION=v1
LOG_LEVEL=info                             # production: info | development: debug

# ─── Database ────────────────────────────────────────────────
# [RENDER DASHBOARD] Render injects this automatically when
# you link a Render PostgreSQL instance to the web service.
# For local dev, point to your local PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplychain_db

# ─── Authentication ──────────────────────────────────────────
# [RENDER DASHBOARD] Generate strong random secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=                                # [RENDER DASHBOARD] — required, no default
JWT_REFRESH_SECRET=                        # [RENDER DASHBOARD] — required, no default
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS & URLs ─────────────────────────────────────────────
# CORS_ORIGIN accepts a comma-separated list of allowed origins.
# [RENDER DASHBOARD] Set this to your frontend domain(s), e.g.:
#   https://your-frontend.onrender.com,https://your-custom-domain.com
# For local dev, use your local frontend URL.
CORS_ORIGIN=http://localhost:5173

# The public base URL of this API (used by Swagger server URL).
# [RENDER DASHBOARD] Set to your Render web service URL, e.g.:
#   https://supplychain-api.onrender.com
API_BASE_URL=http://localhost:3000

# The public base URL of the FRONTEND (used to build the URL encoded inside
# every generated QR code: {FRONTEND_URL}/verify/:token).
# [RENDER DASHBOARD] REQUIRED — set to your deployed Netlify URL, e.g.:
#   https://your-app.netlify.app
# If this is left unset in production, every QR code generated will encode
# a localhost URL and be useless once printed/scanned.
FRONTEND_URL=http://localhost:5173

# ─── Swagger ─────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ─── Storage ─────────────────────────────────────────────────
UPLOAD_DIRECTORY=uploads

# ─── Hyperledger Fabric ──────────────────────────────────────
BLOCKCHAIN_ENABLED=false                   # set true only when the Fabric network and wallet are available
BLOCKCHAIN_AUTO_ANCHOR=true
BLOCKCHAIN_ANCHOR_POLL_MS=5000
BLOCKCHAIN_MAX_RETRIES=5
FABRIC_CHANNEL_NAME=supplychainchannel
FABRIC_CHAINCODE_NAME=supplychain-cc
FABRIC_MSP_ID=PlatformOrgMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=../blockchain/wallet/tlsCert.pem
FABRIC_IDENTITY_CERT_PATH=../blockchain/wallet/cert.pem
FABRIC_IDENTITY_KEY_PATH=../blockchain/wallet/key.pem
