datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                   @id @default(uuid())
  firstName               String
  lastName                String
  email                   String                   @unique
  passwordHash            String
  phoneNumber             String?
  profileImage            String?
  status                  String                   @default("ACTIVE")
  emailVerified           Boolean                  @default(false)
  roleId                  String
  role                    Role                     @relation(fields: [roleId], references: [id])
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  ownedBusinesses         Business[]               @relation("UserOwnedBusinesses")
  uploadedDocuments       BusinessDocument[]
  memberships             BusinessMember[]
  createdProducts         Product[]                @relation("UserCreatedProducts")
  uploadedProductImages   ProductImage[]
  uploadedProductDocuments ProductDocument[]
  performedEvents         SupplyChainEvent[]       @relation("EventPerformer")
  supplyChainComments     SupplyChainComment[]
  generatedIdentities     ProductIdentity[]
  reportDefinitions       ReportDefinition[]
  generatedReports        GeneratedReport[]
  dashboardPreference     DashboardPreference?
  notifications           Notification[]
  announcements           Announcement[]
  updatedSettings         PlatformSetting[]
  updatedFeatureFlags     FeatureFlag[]
  activityLogs            ActivityLog[]
  maintenanceWindows      MaintenanceWindow[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
}

model Business {
  id                      String             @id @default(uuid())
  ownerId                 String
  owner                   User               @relation("UserOwnedBusinesses", fields: [ownerId], references: [id])
  cooperativeId           String?
  cooperative             Cooperative?       @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)
  businessName            String
  tradingName             String
  description             String?
  businessType            String
  industry                String
  registrationNumber      String             @unique
  taxIdentificationNumber String             @unique
  email                   String
  phoneNumber             String
  website                 String?
  logoUrl                 String?
  status                  String             @default("DRAFT") // DRAFT, SUBMITTED, PENDING_VERIFICATION, VERIFIED, ACTIVE, SUSPENDED, ARCHIVED
  verificationStatus      String             @default("PENDING")
  establishedDate         DateTime?
  address                 BusinessAddress?
  documents               BusinessDocument[]
  members                 BusinessMember[]
  products                Product[]
  productCategories       ProductCategory[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model BusinessAddress {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country    String
  province   String
  district   String
  sector     String
  cell       String
  village    String
  postalCode String?
  latitude   Float?
  longitude  Float?
}

model BusinessDocument {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documentType       String   // Registration Certificate, Tax Certificate, Business Permit, National ID, Other
  fileName           String
  fileUrl            String
  uploadedBy         String
  uploader           User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  verificationStatus String   @default("PENDING")
  uploadedAt         DateTime @default(now())
}

model Cooperative {
  id                 String     @id @default(uuid())
  cooperativeName    String     @unique
  description        String?
  registrationNumber String     @unique
  email              String
  phoneNumber        String
  status             String     @default("ACTIVE")
  businesses         Business[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   // Owner, Manager, Employee
  joinedAt   DateTime @default(now())

  @@unique([businessId, userId])
}

model ProductCategory {
  id                String            @id @default(uuid())
  businessId        String?
  business          Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryName      String
  description       String?
  parentCategoryId  String?
  parentCategory    ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subCategories     ProductCategory[] @relation("CategoryHierarchy")
  products          Product[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Product {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId          String
  category            ProductCategory   @relation(fields: [categoryId], references: [id])
  createdBy           String
  creator             User              @relation("UserCreatedProducts", fields: [createdBy], references: [id])
  productName         String
  productCode         String            @unique
  sku                 String            @unique
  barcode             String            @unique
  description         String?
  productType         String
  batchNumber         String?
  countryOfOrigin     String
  productionFacility  String?
  manufacturingDate   DateTime?
  expiryDate          DateTime?
  quantity            Float             @default(0)
  unitOfMeasure       String
  storageRequirements String?
  status              String            @default("DRAFT") // DRAFT, REGISTERED, VERIFIED, ACTIVE, OUT_OF_STOCK, DISCONTINUED, ARCHIVED
  verificationStatus  String            @default("PENDING")
  variants            ProductVariant[]
  images              ProductImage[]
  documents           ProductDocument[]
  supplyChainEvents   SupplyChainEvent[]
  productIdentities   ProductIdentity[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName   String
  sku           String   @unique
  barcode       String   @unique
  quantity      Float    @default(0)
  unitOfMeasure String
  createdAt     DateTime @default(now())
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  displayOrder Int      @default(0)
  uploadedBy   String
  uploader     User     @relation(fields: [uploadedBy], references: [id])
  uploadedAt   DateTime @default(now())
}

model ProductDocument {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  documentType String
  fileName     String
  fileUrl      String
  uploadedBy   String
  uploader     User     @relation(fields: [uploadedBy], references: [id])
  uploadedAt   DateTime @default(now())
}

model SupplyChainEventType {
  id                   String             @id @default(uuid())
  name                 String             @unique
  category             String             // Production, Quality, Storage, Transportation, Retail, Other
  description          String?
  allowedPreviousTypes Json?              // Store array of event type names as a JSON array
  events               SupplyChainEvent[]
  createdAt            DateTime           @default(now())
}

model SupplyChainEvent {
  id              String                  @id @default(uuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId      String
  performedBy     String
  performer       User                    @relation("EventPerformer", fields: [performedBy], references: [id])
  eventTypeId     String
  eventType       SupplyChainEventType    @relation(fields: [eventTypeId], references: [id])
  eventStatus     String                  @default("DRAFT") // DRAFT, SUBMITTED, CONFIRMED, LOCKED
  title           String
  description     String?
  sequenceNumber  Int
  occurredAt      DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  location        SupplyChainLocation?
  attachments     SupplyChainAttachment[]
  comments        SupplyChainComment[]

  @@unique([productId, sequenceNumber])
}

model SupplyChainLocation {
  id        String           @id @default(uuid())
  eventId   String           @unique
  event     SupplyChainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  country   String
  province  String
  district  String
  sector    String
  cell      String
  village   String
  address   String?
  latitude  Float?
  longitude Float?
}

model SupplyChainAttachment {
  id           String           @id @default(uuid())
  eventId      String
  event        SupplyChainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  documentType String           // Image, PDF, Certificate, Delivery Note, Receipt, Inspection Report, Other
  uploadedBy   String
  uploadedAt   DateTime         @default(now())
}

model SupplyChainComment {
  id        String           @id @default(uuid())
  eventId   String
  event     SupplyChainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   String
  createdAt DateTime         @default(now())
}

model ProductIdentity {
  id                     String              @id @default(uuid())
  productId              String
  product                Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId             String
  verificationToken      String              @unique // uuid v4
  qrVersion              Int                 @default(1)
  qrStatus               String              @default("GENERATED") // GENERATED, ACTIVATED, PRINTED, ACTIVE, EXPIRED, REVOKED, ARCHIVED
  generatedBy            String
  generator              User                @relation(fields: [generatedBy], references: [id])
  generatedAt            DateTime            @default(now())
  activatedAt            DateTime?
  expiresAt              DateTime?
  revokedAt              DateTime?
  lastScanAt             DateTime?
  totalScans             Int                 @default(0)
  blockchainStatus       String              @default("PENDING")
  blockchainTransactionId String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  qrCodeAssets           QRCodeAsset[]
  verificationEvents     VerificationEvent[]
}

model QRCodeAsset {
  id                String          @id @default(uuid())
  productIdentityId String
  productIdentity   ProductIdentity @relation(fields: [productIdentityId], references: [id], onDelete: Cascade)
  imagePath         String
  imageFormat       String          // PNG, SVG, PDF
  imageSize         Int
  downloadCount     Int             @default(0)
  printCount        Int             @default(0)
  createdAt         DateTime        @default(now())
}

model VerificationEvent {
  id                String          @id @default(uuid())
  productIdentityId String
  productIdentity   ProductIdentity @relation(fields: [productIdentityId], references: [id], onDelete: Cascade)
  verifiedAt        DateTime        @default(now())
  verificationStatus String         // SUCCESS, FAILED, INVALID_TOKEN, EXPIRED, REVOKED
  country           String?
  province          String?
  district          String?
  ipHash            String
  deviceType        String?
  browser           String?
  operatingSystem   String?
  userAgent         String?
  referrer          String?
  latitude          Float?
  longitude         Float?
  notes             String?
}

model ReportDefinition {
  id               String            @id @default(uuid())
  name             String
  reportType       String            // BUSINESS, PRODUCT, SUPPLY_CHAIN, VERIFICATION, COOPERATIVE, PLATFORM, SYSTEM_ACTIVITY
  createdBy        String
  creator          User              @relation(fields: [createdBy], references: [id])
  filters          String            // JSON stringified filters
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  generatedReports GeneratedReport[]
  reportSchedules  ReportSchedule[]
}

model GeneratedReport {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  generatedBy        String
  generator          User             @relation(fields: [generatedBy], references: [id])
  format             String           // PDF, EXCEL, CSV, JSON
  filePath           String
  generatedAt        DateTime         @default(now())
  expiresAt          DateTime?
}

model DashboardPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboardType String   // ENTREPRENEUR, COOPERATIVE, ADMIN
  layout        String   // JSON stringified layout preference
  widgets       String   // JSON stringified active widgets list
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReportSchedule {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  frequency          String           // DAILY, WEEKLY, MONTHLY
  recipient          String
  format             String           // PDF, EXCEL, CSV, JSON
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  performedBy String
  userRole    String
  ipHash      String
  userAgent   String?
  outcome     String   // SUCCESS, FAILED
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
}

model Notification {
  id               String    @id @default(uuid())
  recipientId      String
  recipient        User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  notificationType String    // BUSINESS_APPROVED, BUSINESS_SUSPENDED, PRODUCT_APPROVED, QR_GENERATED, VERIFICATION_FAILED
  title            String
  message          String
  status           String    @default("PENDING") // PENDING, DELIVERED, READ, ARCHIVED
  readAt           DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  message     String
  audience    String    // ALL_USERS, ENTREPRENEURS, COOPERATIVES, ADMINISTRATORS
  priority    String    @default("NORMAL") // LOW, NORMAL, HIGH
  published   Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  creator     User      @relation(fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now())
}

model PlatformSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique
  settingValue String
  description  String?
  category     String
  updatedBy    String
  updater      User     @relation(fields: [updatedBy], references: [id])
  updatedAt    DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(uuid())
  featureName String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedBy   String
  updater     User     @relation(fields: [updatedBy], references: [id])
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String
  description  String
  entityType   String
  entityId     String
  createdAt    DateTime @default(now())
}

model MaintenanceWindow {
  id          String   @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  enabled     Boolean  @default(false)
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
}
