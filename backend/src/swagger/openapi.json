{
  "openapi": "3.1.0",
  "info": {
    "title": "SupplyChain+ API Docs",
    "description": "REST API Backend for the blockchain-enabled SupplyChain+ platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Health", "description": "System health and status endpoints" },
    { "name": "Auth", "description": "Authentication and authorization endpoints" },
    { "name": "Users", "description": "User profile management" },
    { "name": "Businesses", "description": "Business profile and verification" },
    { "name": "Products", "description": "Product catalog and lifecycle" },
    { "name": "SupplyChain", "description": "Track distribution and production events" },
    { "name": "QR", "description": "Generate and manage secure QR validation codes" },
    { "name": "Verification", "description": "Public product trust audits and verification queries" },
    { "name": "Analytics", "description": "KPI reports and dashboard statistics" },
    { "name": "Reports", "description": "Exportable business performance summaries" },
    { "name": "Notifications", "description": "Activity alerts and push messages" },
    { "name": "Cooperatives", "description": "Manage cooperative membership groups" },
    { "name": "Admin", "description": "Platform-wide administrative operations" },
    { "name": "Blockchain", "description": "Smart contracts and ledger sync operations" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Retrieve server health status",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "status": { "type": "string" },
                    "version": { "type": "string" },
                    "timestamp": { "type": "string" },
                    "uptime": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user (default role Entrepreneur)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "phoneNumber": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registration successful" },
          "400": { "description": "Validation error" },
          "409": { "description": "User already exists" }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify user email token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Email verified successfully" },
          "400": { "description": "Invalid or expired token" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate user credentials and issue JWT tokens",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" },
          "403": { "description": "Email not verified or inactive status" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate access token and refresh token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens rotated successfully" },
          "401": { "description": "Invalid or revoked refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Invalidate user refresh token on logout",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request password reset email mock",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token sent successfully" }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset password using reset token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "password"],
                "properties": {
                  "token": { "type": "string" },
                  "password": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset successfully" },
          "400": { "description": "Invalid or expired token" }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Modify user password (authenticated)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword", "newPasswordConfirmation"],
                "properties": {
                  "currentPassword": { "type": "string" },
                  "newPassword": { "type": "string", "minLength": 6 },
                  "newPasswordConfirmation": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password updated successfully" },
          "400": { "description": "Mismatch or invalid current password" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get authenticated user profile details",
        "responses": {
          "200": { "description": "Success" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/profile": {
      "patch": {
        "tags": ["Auth"],
        "summary": "Update user profile fields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "phoneNumber": { "type": "string" },
                  "profileImage": { "type": "string", "format": "uri" },
                  "profileDetails": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/users/profile": {
      "get": {
        "tags": ["Users"],
        "summary": "Get profile of current user",
        "responses": {
          "200": { "description": "Profile data retrieved" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update profile values",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" }
        }
      }
    },
    "/businesses": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Retrieve business list",
        "responses": { "200": { "description": "Successful retrieval" } }
      },
      "post": {
        "tags": ["Businesses"],
        "summary": "Create business record",
        "responses": { "210": { "description": "Created successfully" } }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Retrieve products list",
        "responses": { "200": { "description": "Successful retrieval" } }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Register a new product",
        "responses": { "201": { "description": "Created successfully" } }
      }
    },
    "/supplychain": {
      "get": {
        "tags": ["SupplyChain"],
        "summary": "Retrieve supplychain tracking history",
        "responses": { "200": { "description": "Successful retrieval" } }
      },
      "post": {
        "tags": ["SupplyChain"],
        "summary": "Register a new supplychain event log",
        "responses": { "201": { "description": "Created successfully" } }
      }
    },
    "/qr": {
      "get": {
        "tags": ["QR"],
        "summary": "Retrieve list of QR logs",
        "responses": { "200": { "description": "Successful retrieval" } }
      },
      "post": {
        "tags": ["QR"],
        "summary": "Register a new QR code",
        "responses": { "201": { "description": "Created successfully" } }
      }
    },
    "/verification": {
      "get": {
        "tags": ["Verification"],
        "summary": "Public verify endpoint",
        "responses": { "200": { "description": "Verified successfully" } }
      }
    },
    "/analytics": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Retrieve stats dashboard overview",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/reports": {
      "get": {
        "tags": ["Reports"],
        "summary": "Export business sheets or report summaries",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Retrieve notifications feed",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/cooperatives": {
      "get": {
        "tags": ["Cooperatives"],
        "summary": "Retrieve cooperative memberships",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/admin": {
      "get": {
        "tags": ["Admin"],
        "summary": "Admin control page settings",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/blockchain": {
      "get": {
        "tags": ["Blockchain"],
        "summary": "Audit logs from ledger node",
        "responses": { "200": { "description": "Success" } }
      }
    }
  }
}
