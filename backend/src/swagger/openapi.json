{
  "openapi": "3.1.0",
  "info": {
    "title": "SupplyChain+ API Docs",
    "description": "REST API Backend for the blockchain-enabled SupplyChain+ platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Health", "description": "System health and status endpoints" },
    { "name": "Auth", "description": "Authentication and authorization endpoints" },
    { "name": "Users", "description": "User profile management" },
    { "name": "Businesses", "description": "Business profile and verification" },
    { "name": "Products", "description": "Product catalog and lifecycle" },
    { "name": "SupplyChain", "description": "Track distribution and production events" },
    { "name": "QR", "description": "Generate and manage secure QR validation codes" },
    { "name": "Verification", "description": "Public product trust audits and verification queries" },
    { "name": "Analytics", "description": "KPI reports and dashboard statistics" },
    { "name": "Reports", "description": "Exportable business performance summaries" },
    { "name": "Notifications", "description": "Activity alerts and push messages" },
    { "name": "Cooperatives", "description": "Manage cooperative membership groups" },
    { "name": "Admin", "description": "Platform-wide administrative operations" },
    { "name": "Blockchain", "description": "Smart contracts and ledger sync operations" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Retrieve server health status",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "status": { "type": "string" },
                    "version": { "type": "string" },
                    "timestamp": { "type": "string" },
                    "uptime": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user (default role Entrepreneur)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "phoneNumber": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registration successful" },
          "400": { "description": "Validation error" },
          "409": { "description": "User already exists" }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify user email token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Email verified successfully" },
          "400": { "description": "Invalid or expired token" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate user credentials and issue JWT tokens",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" },
          "403": { "description": "Email not verified or inactive status" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate access token and refresh token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens rotated successfully" },
          "401": { "description": "Invalid or revoked refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Invalidate user refresh token on logout",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request password reset email mock",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token sent successfully" }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset password using reset token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "password"],
                "properties": {
                  "token": { "type": "string" },
                  "password": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset successfully" },
          "400": { "description": "Invalid or expired token" }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Modify user password (authenticated)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword", "newPasswordConfirmation"],
                "properties": {
                  "currentPassword": { "type": "string" },
                  "newPassword": { "type": "string", "minLength": 6 },
                  "newPasswordConfirmation": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password updated successfully" },
          "400": { "description": "Mismatch or invalid current password" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get authenticated user profile details",
        "responses": {
          "200": { "description": "Success" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/profile": {
      "patch": {
        "tags": ["Auth"],
        "summary": "Update user profile fields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "phoneNumber": { "type": "string" },
                  "profileImage": { "type": "string", "format": "uri" },
                  "profileDetails": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/users/profile": {
      "get": {
        "tags": ["Users"],
        "summary": "Get profile of current user",
        "responses": {
          "200": { "description": "Profile data retrieved" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update profile values",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" }
        }
      }
    },
    "/businesses": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Search and query businesses list",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Search string matching name or tradingName" },
          { "name": "registrationNumber", "in": "query", "schema": { "type": "string" } },
          { "name": "industry", "in": "query", "schema": { "type": "string" } },
          { "name": "businessType", "in": "query", "schema": { "type": "string" } },
          { "name": "verificationStatus", "in": "query", "schema": { "type": "string", "enum": ["PENDING", "VERIFIED", "REJECTED"] } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "List of businesses retrieved successfully" }
        }
      },
      "post": {
        "tags": ["Businesses"],
        "summary": "Register a new business profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessName", "tradingName", "businessType", "industry", "registrationNumber", "taxIdentificationNumber", "email", "phoneNumber"],
                "properties": {
                  "businessName": { "type": "string" },
                  "tradingName": { "type": "string" },
                  "description": { "type": "string" },
                  "businessType": { "type": "string" },
                  "industry": { "type": "string" },
                  "registrationNumber": { "type": "string" },
                  "taxIdentificationNumber": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "phoneNumber": { "type": "string" },
                  "cooperativeId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Business created successfully" },
          "409": { "description": "Conflict (Registration Number or Tax ID exists)" }
        }
      }
    },
    "/businesses/me": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Get businesses owned by or associated with active caller",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/businesses/{id}": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Get full profile details of a specific business",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" },
          "404": { "description": "Business not found" }
        }
      },
      "patch": {
        "tags": ["Businesses"],
        "summary": "Modify business profile information (Owner/Manager only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessName": { "type": "string" },
                  "tradingName": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Business updated successfully" }
        }
      },
      "delete": {
        "tags": ["Businesses"],
        "summary": "Delete a business listing (Primary Owner only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Business deleted successfully" }
        }
      }
    },
    "/businesses/{id}/address": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Get physical location address of a business",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "post": {
        "tags": ["Businesses"],
        "summary": "Set or update business physical address",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["country", "province", "district", "sector", "cell", "village"],
                "properties": {
                  "country": { "type": "string" },
                  "province": { "type": "string" },
                  "district": { "type": "string" },
                  "sector": { "type": "string" },
                  "cell": { "type": "string" },
                  "village": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Address updated successfully" }
        }
      }
    },
    "/businesses/{id}/documents": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Get uploaded documents details list",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "post": {
        "tags": ["Businesses"],
        "summary": "Stage uploaded document metadata check",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["documentType", "fileName", "fileUrl"],
                "properties": {
                  "documentType": { "type": "string", "enum": ["Registration Certificate", "Tax Certificate", "Business Permit", "National ID", "Other"] },
                  "fileName": { "type": "string" },
                  "fileUrl": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "210": { "description": "Created successfully" }
        }
      }
    },
    "/businesses/{id}/members": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Get member roster of business",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "post": {
        "tags": ["Businesses"],
        "summary": "Assign member user to business roster",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["userId", "role"],
                "properties": {
                  "userId": { "type": "string", "format": "uuid" },
                  "role": { "type": "string", "enum": ["Owner", "Manager", "Employee"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Member assigned" }
        }
      }
    },
    "/businesses/{id}/verify": {
      "patch": {
        "tags": ["Businesses"],
        "summary": "Approve/Verify business registration documents (PlatformAdmin only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["verificationStatus"],
                "properties": {
                  "verificationStatus": { "type": "string", "enum": ["PENDING", "VERIFIED", "REJECTED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Verification status updated" }
        }
      }
    },
    "/businesses/{id}/status": {
      "patch": {
        "tags": ["Businesses"],
        "summary": "Update business lifecycle status state",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "PENDING_VERIFICATION", "VERIFIED", "ACTIVE", "SUSPENDED", "ARCHIVED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Status updated successfully" }
        }
      }
    },
    "/businesses/{id}/statistics": {
      "get": {
        "tags": ["Businesses"],
        "summary": "Retrieve count statistics for products, events, and members",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Search products catalog list",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "sku", "in": "query", "schema": { "type": "string" } },
          { "name": "barcode", "in": "query", "schema": { "type": "string" } },
          { "name": "categoryId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "businessId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Successful retrieval" }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Register a new product",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessId", "categoryId", "productName", "productCode", "sku", "barcode", "productType", "countryOfOrigin", "unitOfMeasure"],
                "properties": {
                  "businessId": { "type": "string", "format": "uuid" },
                  "categoryId": { "type": "string", "format": "uuid" },
                  "productName": { "type": "string" },
                  "productCode": { "type": "string" },
                  "sku": { "type": "string" },
                  "barcode": { "type": "string" },
                  "description": { "type": "string" },
                  "productType": { "type": "string" },
                  "countryOfOrigin": { "type": "string" },
                  "quantity": { "type": "number" },
                  "unitOfMeasure": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created successfully" },
          "409": { "description": "SKU or barcode conflicts" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product profile detail",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "patch": {
        "tags": ["Products"],
        "summary": "Modify product profile",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productName": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Delete product listing",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/products/{id}/status": {
      "patch": {
        "tags": ["Products"],
        "summary": "Update product lifecycle status state",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["DRAFT", "REGISTERED", "VERIFIED", "ACTIVE", "OUT_OF_STOCK", "DISCONTINUED", "ARCHIVED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/products/{id}/inventory": {
      "patch": {
        "tags": ["Products"],
        "summary": "Update product inventory stock counts",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quantity", "unitOfMeasure"],
                "properties": {
                  "quantity": { "type": "number" },
                  "unitOfMeasure": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/products/{id}/statistics": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product count metrics",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/products/{id}/history": {
      "get": {
        "tags": ["Products"],
        "summary": "Get history ledger logs for this product",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/products/{id}/images": {
      "get": {
        "tags": ["Products"],
